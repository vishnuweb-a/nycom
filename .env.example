# ─────────────────────────────────────────────────────────────
# Yarnvia — environment template
# Copy to `.env` and fill in. Commit this file; never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Client-side (VITE_ prefixed = bundled into the browser build) ──
# Supabase project URL and anon/publishable key.
# The anon key is public by design; security is enforced by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary cloud name and an UNSIGNED upload preset scoped to yarnvia/.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Server-side ONLY — never add a VITE_ prefix to anything below ──
# Privileged credentials for local seeding/admin scripts run under Node.
# SUPABASE_SERVICE_ROLE bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Airpay payment gateway — server-side ONLY ──
# Set these in Vercel → Project Settings → Environment Variables.
# A VITE_ prefix on any of these would bundle a payment credential into the
# browser build. Never add one.
#
# Credential roles, established empirically against the LIVE gateway. Note these
# are the reverse of the mapping the merchant originally stated -- the gateway
# rejected that one and accepts this one. Do not swap them back.
#   AIRPAY_SECRET_KEY -> the OAuth2 client_secret
#   AIRPAY_API_KEY    -> the `secret` in the privatekey derivation
AIRPAY_MID=
AIRPAY_CLIENT_ID=
AIRPAY_API_KEY=
AIRPAY_SECRET_KEY=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=

# 'live' | 'sandbox'. Order Confirmation only works on a live MID, so this is
# required rather than inferred — the wrong value silently changes how a
# payment is trusted.
AIRPAY_ENV=

# Optional. Overrides the Airpay Order Confirmation endpoint, which defaults to
# https://kraken.airpay.co.in/airpay/pay/v4/api/verify/ — the path the gateway
# actually routes for MID 366950, pinned by a test in api/_lib/airpay.test.ts.
#
# ⚠ Do NOT set this to .../api/orderconfirmation/. An earlier version of this
# comment named that path as the default; the gateway answers it with
# 404 {"message": "no Route matched with those values"}, so verification never
# reaches the API, verifyTransaction returns null, and every order stays
# unsettled. See the note above verifyUrl() in api/_lib/airpay.ts.
#
# Set it only for a merchant onboarded onto a different verification path, or to
# point verification at a local double. Leave it unset rather than blank.
# AIRPAY_VERIFY_URL=

# Absolute origin of this deployment, e.g. https://yarnvia.com — used to build
# the return URL. Falls back to the Vercel-provided host when unset.
PUBLIC_SITE_ORIGIN=

# Outbound callback relay to the merchant's existing KKChat collection endpoint.
# Optional. Unset uses the destination the client confirmed on 2026-08-25:
# https://kkchat.in/callback/cpm/arp_frontiva/collection
#
# The middle path segment is the one that matters. KKChat routes only on the
# trailing /collection and answers 200 "success" to any segment, so pointing
# this at the wrong one relays into a black hole that reports success. The
# earlier value, .../cpm/arp/collection, did exactly that.
# Set to `off` to disable relaying entirely. The relay is auxiliary: it can never
# affect whether a payment settles.
KKCHAT_CALLBACK_URL=

# Bearer token Vercel Cron presents to /api/payments/reconcile. Required — that
# endpoint triggers outbound Order Confirmation calls against the live MID, so
# it must not be openly callable. Vercel sets this automatically when you add a
# CRON_SECRET environment variable in Project Settings.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# SabPaisa PG 3.0 — second online payment provider
#
# Validated INDEPENDENTLY of the Airpay variables above: a missing or malformed
# value here fails only a SabPaisa request, and can never take Airpay checkout,
# the Airpay callback or the nightly reconciler down. That isolation is
# deliberate and is covered by api/_lib/sabpaisa/env.test.ts.
#
# The unprefixed spellings CLIENT_CODE / MERCHANT_ID / API_KEY / SECRET_KEY are
# also accepted, because that is how the merchant's environment was first
# provisioned. The prefixed names below are preferred and win when both are set:
# bare API_KEY and SECRET_KEY are generic enough to collide with any future
# provider's variables.
# ─────────────────────────────────────────────────────────────

# Transaction Enquiry's merchant identifier (`clientCode`).
# NOT interchangeable with SABPAISA_MERCHANT_ID, even though SabPaisa has
# assigned this merchant the same value for both — that is a property of one
# account, not of the protocol, and the code keeps the two roles separate.
SABPAISA_CLIENT_CODE=

# Create Payment's merchant identifier (`merchantId`), and part of the checksum.
SABPAISA_MERCHANT_ID=

# Sent as the `X-Api-Key` request header. Server-side only.
SABPAISA_API_KEY=

# HMAC-SHA256 key for the Create Payment checksum and for verifying the
# return-URL signature. Server-side only; never logged.
SABPAISA_SECRET_KEY=

# API origin, no trailing slash. Must be an https *.sabpaisa.in host — this URL
# receives the API key on every request.
#   production https://merchant-api.sabpaisa.in
#   staging    https://staging-sb-merchant-api.sabpaisa.in
SABPAISA_BASE_URL=https://merchant-api.sabpaisa.in

# Which gateway the storefront's "Pay Online" button hands off to.
# `airpay` (the default when unset) or `sabpaisa`. Public build-time value: it
# selects a destination, not a permission — each gateway's server endpoint
# re-prices the basket and signs the request itself.
VITE_PAYMENT_GATEWAY=airpay
