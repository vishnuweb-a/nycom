{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /*
     * `nodenext`, NOT `bundler`.
     *
     * Vercel does not bundle these functions — it transpiles each `.ts` to a
     * sibling `.js` and lets Node's own ESM loader resolve them at runtime.
     * Because `package.json` declares `"type": "module"`, that loader requires
     * an explicit file extension on every relative import; an extensionless
     * `./_lib/env` throws ERR_MODULE_NOT_FOUND on the first request and takes
     * the whole function down before any handler code runs.
     *
     * `bundler` resolution hid this, because it permits extensionless imports
     * that the deployed runtime rejects — the build was clean and every
     * endpoint 500'd. `nodenext` matches the real runtime, so a missing `.js`
     * is now a compile error here rather than a production outage.
     */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,

    /* Same strictness the browser app is held to. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  /*
   * `src/constants/commerce.ts` is included deliberately: the server re-prices
   * every order and must use the same shipping threshold and fee the storefront
   * quotes. Importing the constant is the only way those cannot drift apart.
   */
  "include": ["api/**/*.ts", "src/constants/commerce.ts"]
}
