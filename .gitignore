# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment — never commit real credentials
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.eslintcache
.cache/
node_modules/.tmp/

# Vercel
.vercel

# Do not commit source photography
clothes/
children/

# Local credential files pulled down by `vercel link` / `vercel env pull`.
# Deliberately NOT the bare `.env*` that `vercel link` appends: that glob also
# matches the tracked `.env.example`, which is the one env file that must stay
# visible.
.env*.local
